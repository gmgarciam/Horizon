{
  "version": "1.0",
"ai": {
  "provider": "openai",
  "model": "gpt-3.5-turbo",
  "api_key_env": "OPENAI_API_KEY",
  "languages": ["en"],
  "throttle_sec": 2,
  "analysis_concurrency": 1
},
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "rss": [
      {
        "name": "BBC World News",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      }
     
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 48
  }
}