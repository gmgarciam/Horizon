{
  "version": "1.0",
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GEMINI_API_KEY",
    "languages": ["en"]
  },
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "rss": [
      {
        "name": "BBC World News",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Reuters World",
        "url": "https://www.rss.app/feeds/reuters-rss-feed.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Al Jazeera",
        "url": "https://www.aljazeera.com/xml/rss/all.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Financial Times",
        "url": "https://www.ft.com/rss/home",
        "enabled": true,
        "category": "business-finance"
      },
      {
        "name": "CNBC World",
        "url": "https://www.cnbc.com/id/100003114/device/rss/rss.html",
        "enabled": true,
        "category": "business-finance"
      },
      {
        "name": "Bloomberg via Investing.com",
        "url": "https://www.investing.com/rss/news.rss",
        "enabled": true,
        "category": "business-finance"
      },
      {
        "name": "Cigar Aficionado",
        "url": "https://www.cigaraficionado.com/feed",
        "enabled": true,
        "category": "cigars"
      },
      {
        "name": "Rocky Patel Cigars",
        "url": "https://rockypatel.com/feed",
        "enabled": true,
        "category": "cigars"
      },
      {
        "name": "Cigar Snob Magazine",
        "url": "https://cigarsnob.com/feed/",
        "enabled": true,
        "category": "cigars"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "worldnews",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 500
        },
        {
          "subreddit": "business",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50
        },
        {
          "subreddit": "economics",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50
        },
        {
          "subreddit": "cigars",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20
        }
      ],
      "users": [],
      "fetch_comments": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 48
  }
}
