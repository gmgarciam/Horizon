{
  "version": "1.0",
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GEMINI_API_KEY",
    "languages": ["en"],
    "throttle_sec": 4,
    "analysis_concurrency": 1
  },
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "rss": [
      {
        "name": "BBC World News",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Al Jazeera",
        "url": "https://www.aljazeera.com/xml/rss/all.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "Financial Times",
        "url": "https://www.ft.com/rss/home",
        "enabled": true,
        "category": "business-finance"
      },
      {
        "name": "Investing.com",
        "url": "https://www.investing.com/rss/news.rss",
        "enabled": true,
        "category": "business-finance"
      },
      {
        "name": "Rocky Patel Cigars",
        "url": "https://rockypatel.com/feed",
        "enabled": true,
        "category": "cigars"
      },
      {
        "name": "Swiss Cuban Cigars",
        "url": "https://swisscubancigars.com/blog/feed",
        "enabled": true,
        "category": "cigars"
      },
      {
        "name": "LI Cigars",
        "url": "https://licigar.com/feed",
        "enabled": true,
        "category": "cigars"
      }
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 48
  }
}