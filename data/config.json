{
  "version": "1.0",
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GEMINI_API_KEY",
    "languages": ["en"],
    "throttle_sec": 15,
    "analysis_concurrency": 1
  },
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "rss": [
      {
        "name": "BBC World News",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      }
     
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 5.0,
    "time_window_hours": 48
  }
}